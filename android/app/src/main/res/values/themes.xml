<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.DylandosIPTV" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Fullscreen Player Theme -->
    <style name="Theme.DylandosIPTV.Fullscreen" parent="Theme.DylandosIPTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
